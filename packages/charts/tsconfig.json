{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@open-tomato/typescript-config/react", "@open-tomato/typescript-config/composite"],
  "compilerOptions": {
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": "src",
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.stories.tsx"]
}
