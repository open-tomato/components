{
  // Stream T's batch check during the port: the package config with
  // isolatedDeclarations on. Recombination moves both flags into
  // tsconfig.json and removes this file.
  //   bunx tsc -p tsconfig.isolated.json | grep '^src/atoms/Button/'
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "isolatedDeclarations": true,
    "noEmit": true
  }
}
