node_modules
dist
storybook-static/
.tmp
.env
.docs/
progress.txt
*.log
.DS_Store

# Visual regression baselines are per-environment and untracked — regenerate
# with `bun run test:visual:update` (packages/ui); never copy them between
# machines.
visual/
visual-report.json
visual-report.first.json
visual-stable.json

# Working plans and sensitive specs are untracked on purpose: they can
# describe critical (privacy/security) bugs before they are patched.
.plans/
.specs/

# Playwright output: `test-results/` holds the per-failure artifacts
# (traces, screenshots, error context) and `playwright-report/` the HTML
# reporter's output. Both are regenerated by every run and neither is ever
# committed.
test-results/
playwright-report/

# >>> rafa tracking: rafa rewrites the lines up to the end marker
.rafa/
# <<< rafa tracking
